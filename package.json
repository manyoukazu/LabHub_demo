{
  "name": "labhub-idea-stock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/wrangler.mjs dev --ip 127.0.0.1 --port 8787",
    "deploy": "node scripts/wrangler.mjs deploy",
    "check": "node --check public/app.js && node --check src/worker.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "db:local": "node scripts/wrangler.mjs d1 migrations apply DB --local",
    "db:remote": "node scripts/wrangler.mjs d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "wrangler": "^4.0.0"
  }
}
