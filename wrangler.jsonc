{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labhub-idea-stock",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "vars": {"APP_MODE": "shared"},
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "labhub-ideas", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}]
}
